    <ui:InvokeCode Code="Dim cutoff As DateTimeOffset = DateTimeOffset.UtcNow.AddDays(-lookbackDays)&#xA;Dim seen As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)&#xA;If System.IO.File.Exists(seenPath) Then&#xA; For Each line As String In System.IO.File.ReadAllLines(seenPath)&#xA;  If line.Trim() &lt;&gt; &quot;&quot; Then seen.Add(line.Trim())&#xA; Next&#xA;End If&#xA;items = New System.Data.DataTable(&quot;Items&quot;)&#xA;items.Columns.Add(&quot;Site&quot;, GetType(String))&#xA;items.Columns.Add(&quot;Title&quot;, GetType(String))&#xA;items.Columns.Add(&quot;Link&quot;, GetType(String))&#xA;items.Columns.Add(&quot;Published&quot;, GetType(DateTimeOffset))&#xA;items.Columns.Add(&quot;Snippet&quot;, GetType(String))&#xA;items.Columns.Add(&quot;ImageUrl&quot;, GetType(String))&#xA;items.Columns.Add(&quot;IsVideo&quot;, GetType(Boolean))&#xA;Dim failures As New List(Of String)&#xA;Dim mediaNs As String = &quot;http://search.yahoo.com/mrss/&quot;&#xA;Dim isWeb As Func(Of String, Boolean) = Function(u) Not String.IsNullOrWhiteSpace(u) AndAlso (u.StartsWith(&quot;http://&quot;, StringComparison.OrdinalIgnoreCase) OrElse u.StartsWith(&quot;https://&quot;, StringComparison.OrdinalIgnoreCase))&#xA;Dim child As Func(Of System.Xml.Linq.XElement, String, System.Xml.Linq.XElement) = Function(e, n) e.Elements().FirstOrDefault(Function(c) c.Name.LocalName = n)&#xA;Dim text As Func(Of System.Xml.Linq.XElement, String, String) = Function(e, n) If(child(e, n) Is Nothing, &quot;&quot;, child(e, n).Value.Trim())&#xA;Dim attr As Func(Of System.Xml.Linq.XElement, String, String) = Function(e, n) If(e.Attribute(n) Is Nothing, &quot;&quot;, e.Attribute(n).Value.Trim())&#xA;Dim imgRx As New System.Text.RegularExpressions.Regex(&quot;&lt;img[^&gt;]+src\s*=\s*[&quot;&quot;']([^&quot;&quot;']+)[&quot;&quot;']&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase)&#xA;Dim tagRx As New System.Text.RegularExpressions.Regex(&quot;&lt;[^&gt;]+&gt;&quot;)&#xA;Dim spaceRx As New System.Text.RegularExpressions.Regex(&quot;\s+&quot;)&#xA;Dim zoneRx As New System.Text.RegularExpressions.Regex(&quot;\s[A-Z]{2,4}$&quot;)&#xA;Using http As New System.Net.Http.HttpClient()&#xA; http.Timeout = TimeSpan.FromSeconds(30)&#xA; http.DefaultRequestHeaders.UserAgent.ParseAdd(&quot;Mozilla/5.0 (compatible; DailySiteDigest/1.0)&quot;)&#xA; Using parser As New Microsoft.VisualBasic.FileIO.TextFieldParser(sitesPath)&#xA;  parser.SetDelimiters(&quot;,&quot;)&#xA;  parser.HasFieldsEnclosedInQuotes = True&#xA;  parser.ReadFields()&#xA;  While Not parser.EndOfData&#xA;   Dim row() As String = parser.ReadFields()&#xA;   If row Is Nothing OrElse row.Length &lt; 2 OrElse row(1).Trim() = &quot;&quot; Then Continue While&#xA;   If row.Length &gt; 2 AndAlso Not {&quot;TRUE&quot;, &quot;Y&quot;, &quot;YES&quot;, &quot;1&quot;}.Contains(row(2).Trim().ToUpperInvariant()) Then Continue While&#xA;   Dim site As String = row(0).Trim()&#xA;   Try&#xA;    Dim doc = System.Xml.Linq.XDocument.Parse(http.GetStringAsync(row(1).Trim()).GetAwaiter().GetResult())&#xA;    Dim found As New List(Of Object())&#xA;    For Each e As System.Xml.Linq.XElement In doc.Descendants().Where(Function(x) x.Name.LocalName = &quot;item&quot; OrElse x.Name.LocalName = &quot;entry&quot;)&#xA;     Dim link As String = &quot;&quot;&#xA;     For Each l As System.Xml.Linq.XElement In e.Elements().Where(Function(c) c.Name.LocalName = &quot;link&quot;)&#xA;      Dim href As String = attr(l, &quot;href&quot;)&#xA;      If href &lt;&gt; &quot;&quot; AndAlso (attr(l, &quot;rel&quot;) = &quot;&quot; OrElse attr(l, &quot;rel&quot;) = &quot;alternate&quot;) Then link = href : Exit For&#xA;      If href = &quot;&quot; AndAlso isWeb(l.Value.Trim()) Then link = l.Value.Trim() : Exit For&#xA;     Next&#xA;     If link = &quot;&quot; AndAlso isWeb(text(e, &quot;guid&quot;)) Then link = text(e, &quot;guid&quot;)&#xA;     If Not isWeb(link) OrElse seen.Contains(link) Then Continue For&#xA;     Dim stamp As String = {text(e, &quot;pubDate&quot;), text(e, &quot;published&quot;), text(e, &quot;updated&quot;), text(e, &quot;date&quot;)}.FirstOrDefault(Function(s) s &lt;&gt; &quot;&quot;)&#xA;     Dim published As DateTimeOffset&#xA;     If stamp Is Nothing OrElse Not (DateTimeOffset.TryParse(stamp, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.AssumeUniversal, published) OrElse DateTimeOffset.TryParse(zoneRx.Replace(stamp, &quot; +0000&quot;), System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.AssumeUniversal, published)) Then published = DateTimeOffset.UtcNow&#xA;     If published &lt; cutoff Then Continue For&#xA;     Dim media = e.Descendants().Where(Function(x) x.Name.NamespaceName = mediaNs).ToList()&#xA;     Dim html As String = {text(e, &quot;encoded&quot;), text(e, &quot;content&quot;), text(e, &quot;description&quot;), text(e, &quot;summary&quot;)}.FirstOrDefault(Function(s) s &lt;&gt; &quot;&quot;)&#xA;     If html Is Nothing Then html = media.Where(Function(x) x.Name.LocalName = &quot;description&quot;).Select(Function(x) x.Value).FirstOrDefault()&#xA;     If html Is Nothing Then html = &quot;&quot;&#xA;     Dim image As String = media.Where(Function(x) x.Name.LocalName = &quot;thumbnail&quot;).Select(Function(x) attr(x, &quot;url&quot;)).FirstOrDefault(Function(u) isWeb(u))&#xA;     If image Is Nothing Then image = media.Where(Function(x) x.Name.LocalName = &quot;content&quot; AndAlso (attr(x, &quot;medium&quot;) = &quot;image&quot; OrElse attr(x, &quot;type&quot;).StartsWith(&quot;image/&quot;))).Select(Function(x) attr(x, &quot;url&quot;)).FirstOrDefault(Function(u) isWeb(u))&#xA;     If image Is Nothing Then image = e.Elements().Where(Function(x) x.Name.LocalName = &quot;enclosure&quot; AndAlso attr(x, &quot;type&quot;).StartsWith(&quot;image/&quot;)).Select(Function(x) attr(x, &quot;url&quot;)).FirstOrDefault(Function(u) isWeb(u))&#xA;     If image Is Nothing Then image = imgRx.Matches(html).Cast(Of System.Text.RegularExpressions.Match)().Select(Function(m) System.Net.WebUtility.HtmlDecode(m.Groups(1).Value)).FirstOrDefault(Function(u) isWeb(u))&#xA;     Dim isVideo As Boolean = e.Descendants().Any(Function(x) x.Name.LocalName = &quot;videoId&quot;) OrElse media.Any(Function(x) x.Name.LocalName = &quot;content&quot; AndAlso (attr(x, &quot;medium&quot;) = &quot;video&quot; OrElse attr(x, &quot;type&quot;).StartsWith(&quot;video/&quot;))) OrElse e.Elements().Any(Function(x) x.Name.LocalName = &quot;enclosure&quot; AndAlso attr(x, &quot;type&quot;).StartsWith(&quot;video/&quot;))&#xA;     Dim snippet As String = spaceRx.Replace(System.Net.WebUtility.HtmlDecode(tagRx.Replace(html, &quot; &quot;)), &quot; &quot;).Trim()&#xA;     If snippet.Length &gt; 300 Then snippet = snippet.Substring(0, 297).TrimEnd() &amp; &quot;...&quot;&#xA;     Dim title As String = spaceRx.Replace(System.Net.WebUtility.HtmlDecode(tagRx.Replace(text(e, &quot;title&quot;), &quot; &quot;)), &quot; &quot;).Trim()&#xA;     seen.Add(link)&#xA;     found.Add(New Object() {site, If(title = &quot;&quot;, link, title), link, published, snippet, If(image, &quot;&quot;), isVideo})&#xA;    Next&#xA;    For Each values As Object() In found.OrderByDescending(Function(v) CStr(v(5)) &lt;&gt; &quot;&quot; OrElse CBool(v(6))).ThenByDescending(Function(v) CType(v(3), DateTimeOffset)).Take(maxPerSite)&#xA;     items.Rows.Add(values)&#xA;    Next&#xA;    Console.WriteLine(&quot;[Site Digest] &quot; &amp; site &amp; &quot;: &quot; &amp; found.Count.ToString() &amp; &quot; new item(s)&quot;)&#xA;   Catch ex As Exception&#xA;    failures.Add(site &amp; &quot;: &quot; &amp; ex.Message)&#xA;    Console.WriteLine(&quot;[Site Digest] &quot; &amp; site &amp; &quot; failed: &quot; &amp; ex.Message)&#xA;   End Try&#xA;  End While&#xA; End Using&#xA;End Using&#xA;failed = String.Join(Environment.NewLine, failures)" ContinueOnError="False" DisplayName="Fetch and parse feeds" Language="VBNet" sap2010:WorkflowViewState.IdRef="InvokeCode_fetch">

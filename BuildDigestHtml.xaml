        <OutArgument x:TypeArguments="x:String" x:Key="html">[OUT_HtmlBody]</OutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="subject">[OUT_Subject]</OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
